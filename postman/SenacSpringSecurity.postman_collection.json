{
  "info": {
    "name": "SenacSpringSecurity",
    "description": "Fluxo de autenticação e autorização com Spring Security. Suba a API com ./mvnw spring-boot:run e rode a coleção (Run collection).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Autenticação (401 x 200)",
      "item": [
        {
          "name": "Rota pública sem login -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status deve ser 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/publico",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "publico"
              ]
            },
            "description": "permitAll(): ninguém precisa se identificar.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Rota protegida sem credenciais -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status deve ser 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/perfil",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "perfil"
              ]
            },
            "description": "Sem header Authorization o filtro nem chega a autenticar.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Senha errada -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status deve ser 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/perfil",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "perfil"
              ]
            },
            "description": "PasswordEncoder.matches devolveu false.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "aluno",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "senha-errada",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Usuário inexistente -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status deve ser 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/perfil",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "perfil"
              ]
            },
            "description": "UserDetailsService lançou UsernameNotFoundException; resposta igual à de senha errada.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "ninguem",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "qualquer",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Credenciais corretas -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status deve ser 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Perfil traz login e papel com prefixo ROLE_\", function () {",
                  "    const corpo = pm.response.json();",
                  "    pm.expect(corpo.login).to.eql(\"aluno\");",
                  "    pm.expect(corpo.papeis).to.include(\"ROLE_ALUNO\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/perfil",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "perfil"
              ]
            },
            "description": "Authentication montado e guardado no SecurityContextHolder.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "aluno",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "aluno123",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
